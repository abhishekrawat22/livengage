HOST=0.0.0.0
PORT=1337

# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Production database (SQLite in .tmp/ gets wiped on most hosts)
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=https://www.livengage.com,https://livengage.com
